{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mintlify Starter Kit",
  "colors": {
    "primary": "#FD5FC2",
    "light": "#F17BB6",
    "dark": "#FD5FC2"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0D0D0D"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Inter"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Trust & Safety",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index",
              "principles",
              "policies/what-we-wont-do"
            ]
          },
          {
            "group": "Policies",
            "pages": [
              "policies/prohibited-content",
              "policies/age-verification",
              "policies/intellectual-property"
            ]
          },
          {
            "group": "Moderation",
            "pages": [
              "moderation/how-it-works",
              "moderation/why-rejected",
              "moderation/appeals"
            ]
          },
          {
            "group": "Reporting",
            "pages": [
              "reporting/how-to-report"
            ]
          },
          {
            "group": "Your account",
            "pages": [
              "your-account/safety-tools",
              "your-account/wellbeing-resources",
              "your-account/privacy-summary"
            ]
          },
          {
            "group": "Contact",
            "pages": [
              "contact"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Report a problem",
      "href": "mailto:support@mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}